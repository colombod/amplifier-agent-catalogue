# Agent Catalogue Configuration
# Copy this file to .env and fill in your values
#
# Provider credentials are used by Amplifier's provider modules.
# Configure via settings.yaml (recommended) or set env vars directly.

# =============================================================================
# LLM Provider Credentials (configure one or more)
# =============================================================================

# Anthropic (Claude models)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT models)
# OPENAI_API_KEY=sk-...

# Azure OpenAI
# AZURE_OPENAI_API_KEY=your-api-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Google Gemini
# GOOGLE_API_KEY=AIza...

# GitHub Copilot (uses GitHub token — many devs already have this)
# Checks in order: COPILOT_GITHUB_TOKEN > GH_TOKEN > GITHUB_TOKEN
# GITHUB_TOKEN=ghp_...
# Or bridge from gh CLI: export GITHUB_TOKEN=$(gh auth token)

# Ollama (no credentials needed — runs locally)

# =============================================================================
# Azure OpenAI Embeddings (for vector similarity search)
# =============================================================================

# Your Azure OpenAI resource endpoint
AS_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# API version to use
AS_AZURE_OPENAI_API_VERSION=2024-02-01

# Deployment name for embedding model
AS_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Embedding model name (must match deployment)
AS_AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimensions (1536 for text-embedding-3-small, 3072 for text-embedding-3-large)
AS_AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# =============================================================================
# Authentication for Embeddings (choose one option)
# =============================================================================

# Option 1: API Key authentication (simplest)
# AS_AZURE_OPENAI_API_KEY=your-api-key-here

# Option 2: RBAC / DefaultAzureCredential
# Set this to true and leave API_KEY unset. Ensure you're authenticated via:
# - Azure CLI: az login
# - Managed Identity (in Azure)
# - Service Principal (set AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID)
# AS_AZURE_OPENAI_USE_RBAC=true

# =============================================================================
# Storage Configuration (optional)
# =============================================================================

# Path to DuckDB database file (defaults to ~/.agent-catalogue/catalogue.duckdb)
# AS_DB_PATH=~/.agent-catalogue/catalogue.duckdb

# =============================================================================
# Server Configuration (optional)
# =============================================================================

# Server host (default: 127.0.0.1)
# AS_HOST=127.0.0.1

# Server port (default: 8000)
# AS_PORT=8000

# Enable debug mode (default: false)
# AS_DEBUG=false

# =============================================================================
# Routing Matrix (optional)
# =============================================================================
# Controls which model handles each agent role (fast, coding, reasoning, etc.)
# Available matrices: balanced (default), quality, economy, anthropic, openai,
#                     gemini, copilot
# Configure in settings.yaml under routing.matrix — env var override not supported.
