# Agent Catalogue Configuration
# Copy this file to .env and fill in your values
#
# All variables are prefixed with AS_ (Agent Store) to avoid clashing
# with other tools that use AZURE_OPENAI_* or OPENAI_* variables.

# =============================================================================
# Azure OpenAI Configuration
# =============================================================================

# Your Azure OpenAI resource endpoint
AS_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# API version to use
AS_AZURE_OPENAI_API_VERSION=2024-02-01

# Deployment name for chat/completion model (used for metadata extraction)
AS_AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# Deployment name for embedding model
AS_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Embedding model name (must match deployment)
AS_AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimensions (1536 for text-embedding-3-small, 3072 for text-embedding-3-large)
AS_AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# =============================================================================
# Authentication (choose one option)
# =============================================================================

# Option 1: API Key authentication (simplest)
# AS_AZURE_OPENAI_API_KEY=your-api-key-here

# Option 2: RBAC / DefaultAzureCredential
# Set this to true and leave API_KEY unset. Ensure you're authenticated via:
# - Azure CLI: az login
# - Managed Identity (in Azure)
# - Service Principal (set AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID)
# AS_AZURE_OPENAI_USE_RBAC=true

# =============================================================================
# Storage Configuration (optional)
# =============================================================================

# Path to DuckDB database file (defaults to ~/.agent-catalogue/catalogue.duckdb)
# AS_DB_PATH=~/.agent-catalogue/catalogue.duckdb

# =============================================================================
# Server Configuration (optional)
# =============================================================================

# Server host (default: 127.0.0.1)
# AS_HOST=127.0.0.1

# Server port (default: 8000)
# AS_PORT=8000

# Enable debug mode (default: false)
# AS_DEBUG=false
